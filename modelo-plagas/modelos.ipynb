    "from ultralytics import YOLO\n",
    "\n",
    "# Carga tu modelo\n",
    "model = YOLO('best.pt')\n",
    "\n",
    "# Extrae el diccionario de clases\n",
    "clases = model.names\n",
    "\n",
    "print(\"Las clases que detecta el modelo son:\")\n",
    "for id, nombre in clases.items():\n",
    "    print(f\"ID {id}: {nombre}\")"
   ]
  }
